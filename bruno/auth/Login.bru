meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // every other request sends this token as its Bearer token
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
}
